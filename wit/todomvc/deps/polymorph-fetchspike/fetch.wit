package polymorph:fetchspike@0.1.0;

/// A minimal buffered HTTP fetch surface: the spike's network capability.
/// Implemented by a dedicated component wrapping `wasip3`'s async
/// `wasi:http/client` (isolating its wit-bindgen runtime); imported by the
/// storage guest. Scoping this import is where the framework's
/// per-destination network grant would attach.
interface fetch {
    /// A buffered response.
    record response {
        status: u16,
        body: list<u8>,
    }

    /// Perform one buffered HTTP request.
    request: async func(method: string, url: string, headers: list<tuple<string, string>>, body: list<u8>) -> result<response, string>;
}

world fetcher {
    export fetch;
}
