/// polymorph:blobstore — DRAFT interface for storage-backend provider
/// components (#19). Status: leaning, not ruling; shaped by two executed
/// spikes (spikes/storage = S3/name-secrecy pole, spikes/dropbox =
/// link-capability pole) and recorded here so the next provider digs
/// (OneDrive, GAS-over-Drive, WebDAV) refine an interface instead of a
/// discussion. Everything is provisional; the whole framework is unstable
/// (see NOTES.md).
///
/// The shape in one paragraph: every provider implements a small REQUIRED
/// FLOOR (authenticated put/delete with overwrite-in-place at stable
/// addresses, fetch-under-capability, owner-only listing for GC) and
/// declares a CAPABILITY PROFILE. The pull tier is a *strategy* chosen
/// per profile: name secrecy + cooperative pickup deletion is the floor
/// strategy that works on any dumb store; where the backend can revoke a
/// bearer capability server-side, the provider exports `pull` natively
/// and the guarantees upgrade (pull-now: cooperative→hard; pull-past:
/// eventual-relocation→immediate). The capability that travels the E2E
/// channel is a tagged union, so recipients fetch through whichever
/// strategy minted it. Revocation-shaped operations RETURN their
/// guarantee class — the NOTES rule that "the UX must not imply hard
/// denial" for cooperative layers becomes machine-carried metadata.
///
/// Composition note (the important structural consequence): the
/// name-secrecy strategy is not provider code. It is a framework-core
/// component that implements `pull` + `pull-fetch` ON TOP OF any
/// provider's `store` + `fetch` floor (derived names via
/// polymorph:webcrypto HMAC, pickup objects per NOTES §Storage backends).
/// Backends with native revocable links skip the wrapper entirely. One
/// pull-tier semantics, two implementations, chosen by profile — and a
/// provider's network grant stays scoped to its own backend hosts either
/// way (the fetch seam composes in front, exactly as in the spikes).
package polymorph:blobstore@0.1.0;

interface types {
    /// How strongly a revocation-shaped effect holds.
    enum enforcement {
        /// Enforced by the backend against arbitrary (modified) clients.
        hard,
        /// Holds only against protocol-honest clients (e.g. pickup-object
        /// deletion under the no-persist discipline). UX must not imply
        /// hard denial when it receives this.
        cooperative,
    }

    /// When the effect takes hold.
    enum timing {
        /// On the order of a request round-trip (Dropbox link revocation
        /// measured in spikes/dropbox: <1s).
        immediate,
        /// After a background job completes (e.g. relocation/compaction
        /// re-uploading history under rotated names on S3-class stores).
        eventual,
    }

    /// The guarantee class attached to an operation's outcome. Providers
    /// report what they actually deliver; the engine records it against
    /// the doc and the consent/revocation UX renders it honestly.
    record guarantee {
        enforcement: enforcement,
        timing: timing,
    }

    /// The pull capability that travels over the E2E channel (sealed, like
    /// any capability). Tagged: recipients dispatch on the variant to the
    /// matching fetch strategy. New strategies extend this union — a
    /// version-gated surface, like every wire format in the plan.
    variant pull-capability {
        /// Name-secrecy strategy (S3-class floor): the container address
        /// plus the current name-key; object names are derived offline as
        /// HMAC(name-key, purpose ++ ref) — spikes/storage. The name-key
        /// rotates on revocation (pull-forward, hard); pickup-object
        /// deletion is cooperative-immediate; relocation is hard-eventual.
        name-secrecy(name-secrecy-cap),
        /// A provider-revocable bearer capability on a container
        /// (Dropbox folder link — spikes/dropbox; OneDrive folder link;
        /// Drive anyone-with-link folder). Names are plain derivable
        /// relative paths beneath it. Revocation is hard-immediate for
        /// pull-now AND pull-past; rotation mints a fresh capability on
        /// the same container.
        share-link(share-link-cap),
    }

    record name-secrecy-cap {
        /// Provider-scoped container address (e.g. endpoint + bucket).
        endpoint: string,
        container: string,
        name-key: list<u8>,
    }

    record share-link-cap {
        /// The bearer URL. Some backends additionally require a mediator
        /// credential for anonymous fetches (Dropbox app auth, a Drive
        /// API key); that credential is provider configuration, not part
        /// of the capability — it ships in the client and is public by
        /// construction (quota/abuse handle, never confidentiality).
        url: string,
    }

    /// Fetch-side absence is deliberately one case: revoked, never
    /// granted, and never existed are indistinguishable (no existence
    /// oracle) — probe-verified posture on both spiked backends.
    variant blob-error {
        /// The object is not reachable through this capability/address.
        absent,
        /// The backend refused the operation (auth, policy).
        refused,
        /// Backend pushback; retry after the given seconds if present.
        rate-limited(option<u32>),
        /// Transport-level failure (the fetch seam).
        transport(string),
        /// Anything protocol-shaped that should not happen.
        protocol(string),
    }
}

/// The owner-side floor. Every provider implements this; nothing in it
/// assumes more than authenticated writes and stable addresses.
/// Credentials/config arrive at provider construction (framework-held),
/// not per call.
interface store {
    use types.{blob-error};

    /// Ensure a container exists. Containers are cheap (a prefix, a
    /// folder) and the ACL/rotation unit — one per doc (× epoch where the
    /// strategy needs it). MUST be a leaf for capability purposes: the
    /// ancestor-link rule (spikes/dropbox P5) means capabilities minted
    /// on ancestors leak into every descendant container.
    ensure-container: async func(container: string) -> result<_, blob-error>;

    /// Destroy a container and everything in it (GC, teardown).
    destroy-container: async func(container: string) -> result<_, blob-error>;

    /// Write an object at a client-chosen name. MUST overwrite in place
    /// at a stable address: stable pickup objects depend on it (and on
    /// link-class backends, on links surviving overwrite — probe P8).
    /// Providers without client-chosen names (Drive) emulate resolution
    /// internally.
    put: async func(container: string, name: string, bytes: list<u8>) -> result<_, blob-error>;

    delete: async func(container: string, name: string) -> result<_, blob-error>;

    /// Owner-authenticated read-back (own-device convergence needs no
    /// pull capability at all — the owner tier bypasses the pull tier).
    get: async func(container: string, name: string) -> result<list<u8>, blob-error>;

    /// Owner-only enumeration, for GC/compaction and orphan detection.
    /// Never required of capability holders; within-container listing BY
    /// capability holders is harmless where the strategy exposes it (one
    /// readership per container).
    list-names: async func(container: string) -> result<list<string>, blob-error>;
}

/// Pull-capability management. Exported natively by providers whose
/// backend can mint/revoke bearer capabilities server-side (profile:
/// `native-pull`); implemented above any floor-only provider by the
/// framework's name-secrecy component. Callers cannot tell which they
/// hold — except through the returned guarantees, which is the point.
interface pull {
    use types.{pull-capability, guarantee, blob-error};

    /// Mint the container's current pull capability.
    mint: async func(container: string) -> result<pull-capability, blob-error>;

    /// Revoke an outstanding capability. Returns what was actually
    /// achieved: hard-immediate on link backends (kills past and present
    /// fetch); cooperative-immediate for pickup deletion under name
    /// secrecy (with hard-eventual following from relocation, reported by
    /// `relocate`).
    revoke: async func(container: string, cap: pull-capability) -> result<guarantee, blob-error>;

    /// Rotate: revoke-and-remint in one step, returning the successor
    /// capability for redistribution (pickup-object rewrite). On link
    /// backends this moves no data; under name secrecy it rotates the
    /// name-key (new objects only — history moves at `relocate`).
    rotate: async func(container: string) -> result<pull-capability, blob-error>;

    /// Make history unreachable under superseded capabilities. Link
    /// backends: a no-op (revocation already covered the past —
    /// hard-immediate). Name-secrecy: relocation/compaction, re-uploading
    /// under current names (hard-eventual). The returned guarantee tells
    /// the UX which story to tell.
    relocate: async func(container: string) -> result<guarantee, blob-error>;
}

/// The recipient-side fetch: the only interface an account-less recipient
/// device ever needs. Deliberately separate from `store` — it holds no
/// owner credentials, and in composition its network grant is the same
/// backend-host seam.
interface pull-fetch {
    use types.{pull-capability, blob-error};

    /// Fetch an object by derived name under a capability. `absent` for
    /// revoked/missing/never-granted alike.
    fetch: async func(cap: pull-capability, name: string) -> result<list<u8>, blob-error>;
}

/// What a provider is, machine-readably; the engine composes strategies
/// from this. (The load-bearing bits from the #19 capability matrix; the
/// rest of that matrix — quota, egress economics, approval friction — is
/// documentation, not interface.)
interface profile {
    use types.{guarantee};

    record capability-profile {
        /// Client-chosen names with overwrite-in-place (floor requires
        /// it; false only for backends emulating names internally).
        client-chosen-names: bool,
        /// Addresses derivable offline by recipients (phrase-only
        /// recovery needs this — a recovery phrase can derive a name,
        /// never a bearer URL; link-only backends fatten the recovery
        /// kit).
        derivable-addresses: bool,
        /// Present iff the backend revokes bearer capabilities
        /// server-side; carries the revocation guarantee it delivers.
        native-pull: option<guarantee>,
        /// Expiring fetch URLs mintable (presigned/downloadUrl-class) —
        /// leak hygiene where available.
        expiring-urls: bool,
        /// Anonymous fetches need a shipped mediator credential (Dropbox
        /// app auth, Drive API key) rather than being open GETs.
        mediated-anonymous-fetch: bool,
    }

    get: func() -> capability-profile;
}

/// A floor-only provider (S3-class, GAS, WebDAV): the framework's
/// name-secrecy component supplies `pull`/`pull-fetch` above it.
world provider {
    export store;
    export pull-fetch;
    export profile;
}

/// A provider whose backend mints/revokes capabilities natively
/// (Dropbox, OneDrive, Drive): the pull tier is the backend's own.
world capable-provider {
    export store;
    export pull;
    export pull-fetch;
    export profile;
}
