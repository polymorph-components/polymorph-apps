package polymorph:storage-spike@0.1.0;

/// The storage spike: an S3-compatible provider (SigV4 signed in-guest via
/// polymorph:webcrypto) plus the cryptographic pull layer — per-epoch
/// name-keys, per-recipient K_p pickup objects, cooperative fetch
/// revocation — against a real S3 server. The host drives devices and
/// recipients as separate instances of this component.
///
/// Spike stand-ins, labeled: read keys travel in a per-recipient
/// "readkeys" object (standing in for keyhive's op stream fetched via
/// name-keys); device-group key delivery is `export-epoch`/`adopt-doc`
/// blobs relayed by the host (standing in for the keyhive device group).
interface driver {
    /// What a reader could reconstruct.
    record doc-view {
        /// The latest decrypted text.
        text: string,
        /// Chunks fetched and opened.
        chunks-read: u32,
    }

    /// Mint the device identity (webcrypto ed25519 for manifest signing,
    /// x25519 for pairwise capabilities) and record the store config.
    /// Empty credentials = a no-account client (fetches unsigned).
    init: async func(endpoint: string, bucket: string, access-key: string, secret-key: string) -> result<string, string>;

    /// This device's x25519 public key (raw), for grants and pairwise
    /// derivation.
    x25519-pub: async func() -> result<list<u8>, string>;

    /// Create the bucket if needed and set the public-read (no-list)
    /// policy: availability by name secrecy. Owner credentials required.
    ensure-bucket-public: async func() -> result<_, string>;

    /// Create a doc: epoch-0 name-key and content-key.
    create-doc: async func() -> result<list<u8>, string>;

    /// Grant a recipient: write their K_p (name-key keychain at the
    /// pairwise-derived location) and readkeys (content-key keychain).
    grant: async func(doc: list<u8>, recipient-pub: list<u8>) -> result<_, string>;

    /// Seal `text` under the current epoch, put the chunk, update this
    /// device's signed manifest. Returns the cref, hex.
    author: async func(doc: list<u8>, text: string) -> result<string, string>;

    /// Device-group stand-in: the doc's key material for another device.
    export-epoch: async func(doc: list<u8>) -> result<list<u8>, string>;

    /// Device-group stand-in: adopt a doc from an epoch blob; the author
    /// device list is the manifest-verification set.
    adopt-doc: async func(doc: list<u8>, epoch-blob: list<u8>, author-devices: list<list<u8>>) -> result<_, string>;

    /// Read as an owner device (keys from local/adopted state).
    read-own: async func(doc: list<u8>) -> result<doc-view, string>;

    /// Read as a granted recipient with no backend account: derive the
    /// K_p location pairwise, fetch keys, manifests, chunks — all
    /// unsigned GETs. Per the no-persist discipline, all pull-layer
    /// material is dropped when the call returns.
    read-shared: async func(doc: list<u8>, owner-pub: list<u8>, author-devices: list<list<u8>>) -> result<doc-view, string>;

    /// Revoke a recipient: delete their K_p, rotate to a new epoch
    /// (name-key + content-key), republish this device's manifest under
    /// the new epoch.
    revoke: async func(doc: list<u8>, recipient-pub: list<u8>) -> result<_, string>;

    /// Everything an honest client has persisted: identity secrets
    /// (worst-case soft keys), store config, doc context, fetched
    /// plaintexts. Deliberately no pull-layer or content keys.
    cracked-image: async func() -> result<list<u8>, string>;

    /// Resurrect from a cracked image: import the identity and context so
    /// `read-shared` attempts exactly what a thief could attempt.
    import-image: async func(image: list<u8>) -> result<_, string>;

    /// Unsigned PUT probe (expect the bucket to refuse: owner-auth writes).
    probe-put: async func(name: string) -> result<u16, string>;

    /// Unsigned list probe (expect refusal: public read is per-object,
    /// enumeration stays closed).
    probe-list: async func() -> result<u16, string>;

    stats: async func() -> string;
}

world spike {
    import polymorph:fetchspike/fetch@0.1.0;
    export driver;
}
