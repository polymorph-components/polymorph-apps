package polymorph:keyhive-spike@0.1.0;

/// Spike scaffolding: one keyhive instance per component instance. The host
/// is the dumb channel — it shuttles opaque byte blobs between two
/// instances and asserts the scenario. No sync protocol lives here
/// (production op sync belongs to the subduction bridge; see NOTES.md,
/// "Provisional plan").
interface driver {
    /// Result of creating a document.
    record doc-created {
        /// Document id (32 bytes; an Ed25519 verifying key).
        doc-id: list<u8>,
        /// blake3 content ref of the initial content (32 bytes).
        content-ref: list<u8>,
    }

    /// Result of encrypting content for a document.
    record encrypted {
        /// blake3 content ref of the plaintext (32 bytes).
        content-ref: list<u8>,
        /// bincode `EncryptedContent<Vec<u8>, [u8; 32]>`.
        ciphertext: list<u8>,
        /// bincode `Vec<StaticEvent>` carrying the CGKA update op, when
        /// the encryption rotated the tree.
        update-events: option<list<u8>>,
    }

    /// Generate the webcrypto-held identity (non-extractable signing key;
    /// the secret never enters guest memory) and the keyhive instance.
    /// Returns the individual id, hex.
    init: async func() -> result<string, string>;

    /// This instance's contact card (bincode).
    contact-card: async func() -> result<list<u8>, string>;

    /// Ingest a peer's contact card (bincode). Returns the peer id, hex.
    receive-contact-card: async func(card: list<u8>) -> result<string, string>;

    /// Create a document owned by this instance; the initial head is
    /// blake3(initial-content). No encryption happens here.
    create-doc: async func(initial-content: list<u8>) -> result<doc-created, string>;

    /// Add a known peer (by 32-byte id) to a document with Read access.
    add-member: async func(doc-id: list<u8>, peer-id: list<u8>) -> result<_, string>;

    /// Revoke a member from a document (retaining all other members).
    revoke-member: async func(doc-id: list<u8>, peer-id: list<u8>) -> result<_, string>;

    /// All static events this instance holds that are relevant for the
    /// given peer (bincode `Vec<StaticEvent>`).
    events-for-peer: async func(peer-id: list<u8>) -> result<list<u8>, string>;

    /// Ingest a bincode `Vec<StaticEvent>`. Returns how many events
    /// remained stuck (unresolved dependencies); 0 is the healthy case.
    ingest-events: async func(events: list<u8>) -> result<u32, string>;

    /// Encrypt content for a document. `pred-ref` is the previous content
    /// ref (32 bytes), or empty on the first write.
    encrypt: async func(doc-id: list<u8>, content: list<u8>, pred-ref: list<u8>) -> result<encrypted, string>;

    /// Decrypt a bincode `EncryptedContent` for a document.
    decrypt: async func(doc-id: list<u8>, ciphertext: list<u8>) -> result<list<u8>, string>;

    /// Serialize the full keyhive state, restore it from the bytes with
    /// the same webcrypto-held signer, and swap the live instance for the
    /// restored one. Returns a human-readable summary.
    archive-roundtrip: async func() -> result<string, string>;

    /// Counters (signature calls across the WIT boundary, known peers).
    stats: async func() -> string;
}

world spike {
    export driver;
}
