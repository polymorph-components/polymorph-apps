# Keyhive spike: build the guest component, run the two-instance scenario.

guest:
    cargo build --target wasm32-wasip2 --release -p spike-guest

run: guest
    cargo run --release -p spike-host -- target/wasm32-wasip2/release/spike_guest.wasm

check:
    cargo clippy --target wasm32-wasip2 -p spike-guest -- -D warnings
    cargo clippy -p spike-host -- -D warnings
