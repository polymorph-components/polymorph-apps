# Walking-skeleton spike: automerge ↔ keyhive ↔ subduction over component-iroh.
#
# Needs a polymorph-iroh checkout (endpoint component + relay built);
# see README.

IROH_CHECKOUT := env_var_or_default("IROH_CHECKOUT", "../../../polymorph-iroh")

guest:
    cargo build --target wasm32-wasip2 --release -p spike-guest

compose: guest
    wac plug target/wasm32-wasip2/release/spike_guest.wasm \
        --plug {{IROH_CHECKOUT}}/target/wasm32-wasip2/release/iroh_endpoint.wasm \
        -o target/composed.wasm

run: compose
    #!/usr/bin/env bash
    set -euo pipefail
    relay="{{IROH_CHECKOUT}}/.deps/iroh/target/release/iroh-relay"
    [ -x "$relay" ] || { echo "iroh-relay not built at $relay" >&2; exit 1; }
    "$relay" --dev &
    relay_pid=$!
    trap 'kill $relay_pid 2>/dev/null || true' EXIT
    sleep 0.5
    cargo run --release -p spike-host -- target/composed.wasm --relay http://127.0.0.1:3340

check:
    cargo clippy --target wasm32-wasip2 -p spike-guest -- -D warnings
    cargo clippy -p spike-host -- -D warnings
