package polymorph:engine-spike@0.1.0;

/// The engine spike (#20 G2): the walking skeleton's content spine
/// generalized from a linear chain to the real automerge change DAG, with
/// the `polymorph-data:tasks` service served from inside the engine
/// composite (demo-v1 topology). Chunk identity = automerge ChangeHash;
/// chunk parents = the change's deps = keyhive predecessor refs =
/// sedimentree parents — one DAG across all three layers.
interface driver {
    /// One webcrypto identity backing keyhive and subduction; both layers
    /// built, tasks service ready to bind a partition. Returns the id, hex.
    /// `exportable-identity` selects the G5 demo-grade SOFT key (in-guest,
    /// bundle-exportable) instead of the platform-held default — the
    /// webcrypto interface has no private-key export at this rev (a #11
    /// data point; the platform keystore slice is the honest fix).
    init: async func(exportable-identity: bool) -> result<string, string>;

    // --- keyhive membership (synced by the bridge over the wire) ---
    //
    // Agent ids are 32-byte identifiers; individuals, groups, and docs
    // share the id space. G3: users are GROUPS of device individuals —
    // partitions are delegated to groups, sharing adds the other user's
    // group, and "lost phone" and "removed collaborator" are the same
    // revocation mechanic at different nodes of the delegation graph.

    kh-knows-agent: async func(agent-id: list<u8>) -> result<bool, string>;

    /// Create a group; the caller's individual is its first (admin) member.
    kh-create-group: async func() -> result<list<u8>, string>;

    /// Enroll an agent into a group. `level` is one of "read", "edit",
    /// "admin". Adding to a group propagates CGKA adds to every doc that
    /// (transitively) contains the group — from the next epoch onward.
    kh-add-to-group: async func(group-id: list<u8>, member-id: list<u8>, level: string) -> result<_, string>;

    /// Revoke an agent from a group ("lost phone"): docs containing the
    /// group drop CGKA leaves for individuals no longer reachable.
    kh-revoke-from-group: async func(group-id: list<u8>, member-id: list<u8>) -> result<_, string>;

    /// Export the constitutive events reachable to an agent (a "group
    /// card"): bincoded static events, carried out of band (QR/paste in
    /// the product; the host in this spike). The bridge only offers a
    /// group's ops to its members, so sharing with a foreign group needs
    /// its card ingested first.
    kh-export-card: async func(agent-id: list<u8>) -> result<list<u8>, string>;

    /// Ingest a pasted card. Returns how many events stayed pending
    /// (unresolvable until more context arrives).
    kh-ingest-card: async func(card: list<u8>) -> result<u32, string>;

    /// `level` is one of "read", "edit", "admin" (authors need "edit":
    /// subduction's put policy requires it). The agent may be an
    /// individual or a group (transitive members get CGKA leaves).
    kh-add-member: async func(doc-id: list<u8>, agent-id: list<u8>, level: string) -> result<_, string>;
    kh-revoke-member: async func(doc-id: list<u8>, agent-id: list<u8>) -> result<_, string>;

    /// Keyhive contact card (bincode): materializes the individual +
    /// prekeys on ingest. The enrollment/QR artifact for devices that
    /// have never touched the wire.
    kh-contact-card: async func() -> result<list<u8>, string>;
    kh-ingest-contact: async func(card: list<u8>) -> result<_, string>;

    // --- the bucket path (#19's pull layer under this engine; G4, plus
    // --- the spikes/dropbox link-capability strategy) ---
    //
    // Two provider strategies behind one surface (wit/blobstore.wit is
    // the generalized draft). S3: object names HMAC-derived from
    // per-epoch name-keys; members bootstrap from a per-member K_p pickup
    // object wrapped to keyhive contact-card prekeys; the keyhive op
    // stream is stored as name-keyed blobs so a cold device can join from
    // the bucket alone. Dropbox: plain derivable paths under a per-doc
    // folder whose shared link is the pull capability; pickup objects are
    // per-member sealed files with their own revocable links; revocation
    // is server-side, hard, and retroactive.

    record s3-config {
        endpoint: string,
        bucket: string,
        access-key: string,
        secret-key: string,
    }

    /// Consumer Dropbox (app-folder app). An empty access-token = a
    /// link-tier recipient: no write path, pulls ride a pickup link with
    /// app auth alone (the app key/secret are public identifiers in any
    /// shipped client). A non-empty refresh-token lets the guest refresh
    /// an expired access token in place (PKCE public client: the token
    /// endpoint wants only the app key).
    record dropbox-config {
        app-key: string,
        app-secret: string,
        access-token: string,
        refresh-token: string,
        root: string,
    }

    variant store-config {
        s3(s3-config),
        dropbox(dropbox-config),
    }

    init-store: async func(config: store-config) -> result<_, string>;

    /// S3: create the bucket + public-read-no-list policy. Dropbox:
    /// ensure the root folders (doc folders + links are minted lazily).
    ensure-bucket: async func() -> result<_, string>;

    /// Publish/refresh the member's pickup object, sealed to a keyhive
    /// contact-card prekey DH. S3: K_p (name-key keychain + author
    /// device list) at the derivable location — returns none. Dropbox:
    /// the sealed pickup file (doc folder link + device list), plus the
    /// file's own minted link, returned — the member's standing
    /// capability, carried by the caller in lieu of the E2E channel.
    store-grant: async func(doc-id: list<u8>, member-id: list<u8>) -> result<option<string>, string>;

    /// Revoke the member's pickup and rotate the pull tier. S3: delete
    /// K_p + rotate the name-key epoch, republish for the remaining
    /// grantees (cooperative now, hard forward). Dropbox: revoke +
    /// delete their pickup link, revoke + re-mint the doc folder link,
    /// rewrite remaining pickups in place (hard + retroactive,
    /// server-side). Returns a human-readable guarantee note for the UI
    /// — the blobstore draft's guarantee class, as prose for now.
    store-revoke: async func(doc-id: list<u8>, member-id: list<u8>) -> result<string, string>;

    /// Push new chunks (envelope bytes), the op-stream blob, and the
    /// signed manifest. Owner tier (S3 credentials / Dropbox token).
    bucket-flush: async func(doc-id: list<u8>) -> result<string, string>;

    /// Pull: op stream into keyhive, chunks into the sedimentree, then
    /// apply. Works with zero live connections. `pickup` is the standing
    /// pickup link for link-tier recipients (Dropbox without a token);
    /// S3 derives the K_p location instead, and Dropbox owner-tier pulls
    /// by path — both ignore it.
    bucket-pull: async func(doc-id: list<u8>, owner-id: list<u8>, pickup: option<string>) -> result<string, string>;

    // --- the identity bundle (#20 G5; #11's persistence slice) ---
    //
    // One sealed bundle (keyhive archive + identity key + partition
    // refs) under a random bundle key held in KEYSLOTS, LUKS-style: a
    // passphrase slot (argon2id — the downloadable-file wrap) and/or a
    // raw 32-byte-secret slot (passkey-PRF / recovery-code stand-in).
    // Everything else rehydrates from the bucket (G4), so this bundle
    // plus store config is a complete device restart.

    /// Export the sealed bundle. At least one slot must be requested.
    identity-export: async func(label: string, passphrase: option<string>, secret-slot: option<list<u8>>) -> result<list<u8>, string>;

    /// Initialize this instance FROM a bundle (instead of `init`):
    /// restores identity + keyhive state and binds the tasks service to
    /// the bundled partition. Returns the identity id, hex.
    identity-import: async func(bundle: list<u8>, passphrase: option<string>, secret: option<list<u8>>) -> result<string, string>;

    // --- the iroh wire + subduction sync (from the skeleton) ---

    iroh-bind: async func(relay-url: string) -> result<string, string>;
    iroh-start: async func(initiator: bool, peer-endpoint-id: list<u8>, relay-url: string, expected-peer: list<u8>) -> result<u32, string>;
    conn-status: async func(conn: u32) -> result<option<string>, string>;
    sync-start: async func(peer: list<u8>, tree: list<u8>, subscribe: bool) -> result<u32, string>;
    sync-status: async func(handle: u32) -> result<option<string>, string>;

    // --- partition lifecycle (the create → add members → seal ordering
    // --- is load-bearing: epoch membership at seal time determines
    // --- readability) ---

    /// Create the partition: keyhive doc + the automerge creation change
    /// (the todos map), held UNSEALED so members can be added first.
    create-partition: async func() -> result<list<u8>, string>;

    /// Encrypt and commit the pending creation change under the current
    /// epoch, and bind the tasks service to this partition.
    seal-partition: async func(id: list<u8>) -> result<_, string>;

    /// Bind the tasks service to a partition this instance did not create
    /// (members receive everything through sync).
    adopt-partition: async func(id: list<u8>) -> result<_, string>;

    /// DAG evidence: (chunks known, max parent count over chunks).
    chunk-stats: async func(id: list<u8>) -> result<tuple<u32, u32>, string>;

    stats: async func() -> string;
}

world spike {
    import polymorph:iroh/endpoint@0.1.0;
    import polymorph:iroh/identity-generate@0.1.0;
    import polymorph:fetchspike/fetch@0.1.0;
    export driver;
    export polymorph-data:tasks/tasks@0.1.0;
}
