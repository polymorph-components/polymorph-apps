package polymorph:skeleton-spike@0.1.0;

/// The walking skeleton: automerge content end-to-end encrypted under
/// keyhive groups, synced as ciphertext by subduction over a
/// component-iroh QUIC wire — one engine composite per peer, one
/// platform-held identity backing both keyhive and subduction.
///
/// Phase 3b: the subduction_keyhive bridge carries membership/CGKA ops
/// over a second stream of the same iroh connection, and the keyhive
/// auth graph gates subduction's pull policy (no host shuttle, no open
/// policy).
interface driver {
    /// Result of authoring a change.
    record authored {
        /// The shared doc id: the keyhive DocumentId, doubling as the
        /// sedimentree id (32 bytes).
        id: list<u8>,
        /// blake3 of the plaintext chunk (32 bytes): the keyhive content
        /// ref and the sedimentree commit head.
        content-ref: list<u8>,
    }

    /// What a reader could reconstruct.
    record doc-view {
        /// The automerge document's "msg" value after applying every
        /// decryptable chunk in causal order.
        text: string,
        /// Chunks decrypted and applied.
        chunks-read: u32,
        /// Chunks present in the sedimentree but undecryptable.
        chunks-failed: u32,
        /// The last decryption error, when any chunk failed.
        last-error: option<string>,
    }

    /// One webcrypto identity (non-extractable) backing both the keyhive
    /// individual and the subduction peer; both layers built and their
    /// tasks spawned. Returns the shared id, hex.
    init: async func() -> result<string, string>;

    // --- keyhive membership (synced by the bridge over the wire) ---

    /// Whether this instance's keyhive knows the given agent (contact
    /// cards travel over the bridge's protocol).
    kh-knows-peer: async func(peer-id: list<u8>) -> result<bool, string>;
    kh-add-member: async func(doc-id: list<u8>, peer-id: list<u8>) -> result<_, string>;
    kh-revoke-member: async func(doc-id: list<u8>, peer-id: list<u8>) -> result<_, string>;

    // --- the iroh wire + subduction sync (from spike 2) ---

    iroh-bind: async func(relay-url: string) -> result<string, string>;
    iroh-start: async func(initiator: bool, peer-endpoint-id: list<u8>, relay-url: string, expected-peer: list<u8>) -> result<u32, string>;
    conn-status: async func(conn: u32) -> result<option<string>, string>;
    sync-start: async func(peer: list<u8>, tree: list<u8>, subscribe: bool) -> result<u32, string>;
    sync-status: async func(handle: u32) -> result<option<string>, string>;
    /// Sedimentree commit heads currently held (sorted) — the pull view.
    commits: async func(tree: list<u8>) -> result<list<list<u8>>, string>;

    // --- the content spine ---

    /// Create the shared doc: new automerge doc with "msg" = initial-text
    /// and a keyhive document keyed to the initial chunk. The chunk is NOT
    /// yet encrypted: add members first, then `seal-initial`, so the first
    /// epoch already includes them.
    create-shared: async func(initial-text: string) -> result<authored, string>;

    /// Encrypt and commit the pending initial chunk under the doc's
    /// current epoch.
    seal-initial: async func(id: list<u8>) -> result<authored, string>;

    /// Author a change: set "msg" = text, encrypt the incremental chunk
    /// under the doc's current epoch, commit it (parent = previous ref).
    author-change: async func(id: list<u8>, text: string) -> result<authored, string>;

    /// Rebuild the document from the sedimentree: decrypt every chunk the
    /// current epoch allows, apply in causal order.
    read-doc: async func(id: list<u8>) -> result<doc-view, string>;

    stats: async func() -> string;
}

world spike {
    import polymorph:iroh/endpoint@0.1.0;
    import polymorph:iroh/identity-generate@0.1.0;
    export driver;
}
