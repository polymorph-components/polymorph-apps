package polymorph:dropbox-spike@0.1.0;

/// The Dropbox provider spike: the dumb-store contract implemented over
/// consumer Dropbox (app-folder app), exercising the link-capability pull
/// strategy from the #19 capability profile — shared links as container
/// capabilities, hard server-side revocation, pickup objects as stable
/// per-recipient files with their own revocable links.
///
/// Strategy deltas vs the S3 spike (spikes/storage), by design:
/// - No name secrecy: object names are plain derivable paths (cref hex)
///   under one stable per-doc folder; the folder's shared link is the pull
///   capability, and within-container listing by capability holders is
///   harmless by construction (one readership per container).
/// - No K_p relocation/compaction: revoking the doc link kills pull-now
///   AND pull-past (hard, against modified clients); minting a fresh link
///   on the same folder is pull-forward. Zero data movement.
/// - The pickup object is a per-recipient sealed file whose own file link
///   is the recipient's standing capability: overwritten in place on
///   rotation (the link keeps serving), link-revoked + deleted on revoke.
///
/// Spike stand-ins, labeled: read keys travel in a per-recipient sealed
/// "readkeys" object (standing in for keyhive's op stream); device-group
/// key delivery is `export-doc`/`adopt-doc` blobs relayed by the host;
/// pickup links are returned from `grant` and relayed by the host
/// (standing in for the E2E contact channel).
interface driver {
    /// What a reader could reconstruct.
    record doc-view {
        /// The latest decrypted text.
        text: string,
        /// Chunks fetched and opened.
        chunks-read: u32,
    }

    /// Mint the device identity (webcrypto ed25519 for manifest signing,
    /// x25519 for pairwise sealing) and record credentials. Owner devices
    /// pass the user access token; account-less recipients pass an empty
    /// token and authenticate shared-link fetches with app auth alone
    /// (Basic app-key:app-secret). `root` namespaces this run's paths
    /// inside the app folder.
    init: async func(root: string, app-key: string, app-secret: string, access-token: string) -> result<string, string>;

    /// This device's x25519 public key (raw), for grants and pairwise
    /// sealing.
    x25519-pub: async func() -> result<list<u8>, string>;

    /// Create a doc: the folder, the epoch-0 content key, and the doc
    /// folder link (the container pull capability). Owner only.
    create-doc: async func() -> result<list<u8>, string>;

    /// Grant a recipient: write their pairwise-sealed readkeys object and
    /// their sealed pickup file (carrying the current doc link), mint the
    /// pickup file's own link, and return it — the recipient's standing
    /// capability, delivered by the host in lieu of the E2E channel.
    grant: async func(doc: list<u8>, recipient-pub: list<u8>) -> result<string, string>;

    /// Seal `text` under the current content epoch, upload the chunk at
    /// its derivable name, update this device's signed manifest. Returns
    /// the cref, hex.
    author: async func(doc: list<u8>, text: string) -> result<string, string>;

    /// Device-group stand-in: the doc's content keychain for another
    /// device of the same owner.
    export-doc: async func(doc: list<u8>) -> result<list<u8>, string>;

    /// Device-group stand-in: adopt a doc from an exported blob; the
    /// author device list is the manifest-verification set.
    adopt-doc: async func(doc: list<u8>, blob: list<u8>, author-devices: list<list<u8>>) -> result<_, string>;

    /// Read as an owner device: Bearer-authenticated downloads by path.
    /// The pull tier (links) is not involved at all.
    read-own: async func(doc: list<u8>) -> result<doc-view, string>;

    /// Read as an account-less recipient: pickup link -> doc link ->
    /// readkeys -> manifests -> chunks, all app-authenticated shared-link
    /// fetches. Session link material is dropped on return (the no-persist
    /// discipline, kept as leak hygiene); the pickup link is the standing
    /// capability. DELIBERATE EXCEPTION, labeled: the resolved doc link is
    /// hoarded into instance state so `cracked-image` models a maximally
    /// dishonest client — the revocation assertions must hold anyway.
    read-shared: async func(doc: list<u8>, pickup-link: string, owner-pub: list<u8>, author-devices: list<list<u8>>) -> result<doc-view, string>;

    /// Revoke a recipient: revoke + delete their pickup file and readkeys,
    /// revoke the doc folder link (pull-now AND pull-past, hard,
    /// server-side), mint a fresh doc link, rotate the content epoch, and
    /// rewrite remaining recipients' pickup + readkeys objects in place
    /// (their standing links keep serving).
    revoke: async func(doc: list<u8>, recipient-pub: list<u8>) -> result<_, string>;

    /// Everything a worst-case client image contains: soft identity
    /// secrets, config, the standing pickup link, the HOARDED doc link
    /// (no-persist violation, deliberate), and fetched plaintexts.
    cracked-image: async func() -> result<list<u8>, string>;

    /// Resurrect from a cracked image: import identity + context so the
    /// read attempts try exactly what a thief could try.
    import-image: async func(image: list<u8>) -> result<_, string>;

    /// Read attempt from an imported image: the pickup link first, then
    /// the hoarded doc link directly. Post-revocation both must be
    /// refused server-side — the assertion the S3 strategy cannot make.
    read-cracked: async func() -> result<doc-view, string>;

    /// Fetch a link with no credentials at all (expect refusal: the API
    /// path requires at least app auth as the anonymous-fetch mediator).
    probe-noauth: async func(link: string) -> result<u16, string>;

    /// Attempt a write with app auth only (expect refusal: writes are
    /// owner-token-only).
    probe-write: async func(name: string) -> result<u16, string>;

    /// Delete this run's root folder (leaves the account clean).
    cleanup: async func() -> result<_, string>;

    stats: async func() -> string;
}

world spike {
    import polymorph:fetchspike/fetch@0.1.0;
    export driver;
}
