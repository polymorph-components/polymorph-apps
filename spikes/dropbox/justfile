# Dropbox provider spike: link-capability pull strategy over consumer
# Dropbox. Needs a creds file (see README): {appKey, appSecret, accessToken}.

creds := env_var_or_default("DROPBOX_APP_JSON", env_var("HOME") + "/tmp/dropbox-app.json")

fetcher:
    cargo build --target wasm32-wasip2 --release -p spike-fetcher

guest:
    cargo build --target wasm32-wasip2 --release -p spike-guest

compose: fetcher guest
    wac plug target/wasm32-wasip2/release/spike_guest.wasm \
        --plug target/wasm32-wasip2/release/spike_fetcher.wasm \
        -o target/composed.wasm

# The raw-HTTP probe suite: executable assertions for the platform facts
# the provider design rests on (link semantics, revocation, CORS, gating).
probe:
    ./probe.sh "{{creds}}"

run: compose
    cargo run --release -p spike-host -- target/composed.wasm --creds "{{creds}}"

check:
    cargo clippy --target wasm32-wasip2 -p spike-fetcher -- -D warnings
    cargo clippy --target wasm32-wasip2 -p spike-guest -- -D warnings
    cargo clippy -p spike-host -- -D warnings
