# Post-seal-add readability investigation. Two targets, one scenario source.

# The revision spikes/tasks-engine ships.
pinned:
    cargo run --release -p addwedge-pinned | tee results-pinned.txt

# Whatever upstream `main` resolves to in this workspace's Cargo.lock.
main:
    cargo run --release -p addwedge-main | tee results-main.txt

both: pinned main

check:
    cargo clippy --workspace --all-targets -- -D warnings

# Re-resolve the `main` runner against current upstream HEAD.
