package polymorph-data:tasks@0.1.0;

/// The first data service: a shared task list.
///
/// This is a **schema-authority** contract (NOTES.md, "System services"):
/// one live service instance owns a partition of task data — its automerge
/// schema, its policy, its migrations — and any number of apps project it
/// (a list, a board, a chart). Apps never touch document surfaces; they
/// bind this interface and the framework links them to the partition's
/// authority.
///
/// v0.1 is deliberately poll-shaped: `revision` is a cheap monotonic probe
/// and `items` returns a full snapshot. A change-feed subscription (WIT
/// stream of deltas) is the expected v0.2 addition once the app-side event
/// plumbing (#16's event-record path) settles. Versioning follows the
/// family rules: additive growth via new methods; this package's versions
/// are facades served by ONE live schema authority per partition.
interface tasks {
    /// One task.
    record todo-item {
        /// Stable, opaque, unique within the partition.
        id: string,
        title: string,
        completed: bool,
    }

    /// A consistent view of the partition.
    record snapshot {
        /// Monotonic per-replica revision: advances whenever a local or
        /// synced change is applied. Equal revisions on one replica imply
        /// an unchanged snapshot; revisions are NOT comparable across
        /// replicas.
        revision: u64,
        /// Items in stable (id) order.
        items: list<todo-item>,
    }

    /// The partition this instance serves (the document id). Partition
    /// selection/creation is the framework's concern, not an app's.
    partition: async func() -> result<list<u8>, string>;

    /// Apply any newly synced changes, then report the revision.
    revision: async func() -> result<u64, string>;

    /// Apply any newly synced changes, then snapshot.
    items: async func() -> result<snapshot, string>;

    /// Create a task. Returns its id.
    add: async func(title: string) -> result<string, string>;

    set-completed: async func(id: string, completed: bool) -> result<_, string>;
    set-title: async func(id: string, title: string) -> result<_, string>;
    remove: async func(id: string) -> result<_, string>;
}

/// The standalone service world: what a separate tasks-service component
/// exports once it is split out of the engine composite (demo v1 serves
/// this interface from inside the engine; the contract is identical).
world tasks-service {
    export tasks;
}
