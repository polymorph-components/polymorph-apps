# Subduction spike: shuttle wire (phase 2a) and iroh wire (phase 2b).
#
# The iroh wire needs the polymorph-iroh endpoint component and the stock
# iroh-relay binary; IROH_CHECKOUT points at a polymorph-iroh checkout that
# has run `just build-components` and `just relay-build` (see README).

IROH_CHECKOUT := env_var_or_default("IROH_CHECKOUT", "../../../polymorph-iroh")

guest:
    cargo build --target wasm32-wasip2 --release -p spike-guest

compose: guest
    wac plug target/wasm32-wasip2/release/spike_guest.wasm \
        --plug {{IROH_CHECKOUT}}/target/wasm32-wasip2/release/iroh_endpoint.wasm \
        -o target/composed.wasm

# Phase 2a: the host-shuttled wire.
run: compose
    cargo run --release -p spike-host -- target/composed.wasm --wire shuttle

# Phase 2b: the iroh wire through a local relay (started and stopped here).
run-iroh: compose
    #!/usr/bin/env bash
    set -euo pipefail
    relay="{{IROH_CHECKOUT}}/.deps/iroh/target/release/iroh-relay"
    [ -x "$relay" ] || { echo "iroh-relay not built at $relay" >&2; exit 1; }
    "$relay" --dev &
    relay_pid=$!
    trap 'kill $relay_pid 2>/dev/null || true' EXIT
    sleep 0.5
    cargo run --release -p spike-host -- target/composed.wasm --wire iroh --relay http://127.0.0.1:3340

check:
    cargo clippy --target wasm32-wasip2 -p spike-guest -- -D warnings
    cargo clippy -p spike-host -- -D warnings
